         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Ruminant digestion system with inner digestive structure outline diagram. Labeled educational scheme with rumen, reticulum, omasum and abomasum process stages vector illustration. Veterinary biology.</rdf:li>
            </rdf:Alt>
         </dc:description>
